{
  "name": "ThaliSense: AI nutrition coach for Indian meals",
  "short_name": "ThaliSense",
  "description": "Snap your thali, see your diabetes risk, and get a 7-day regional meal plan from an on-device AI coach.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0a0908",
  "theme_color": "#0a0908",
  "categories": ["health", "food", "lifestyle"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Log a meal", "url": "/?tab=today", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Run the coach", "url": "/?tab=coach", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
