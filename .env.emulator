# Test build wired to the local Firebase emulators (npm run e2e:auth).
# "demo-" projects never reach real Firebase, so these values are not secrets.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-thalisense.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-thalisense
VITE_FIREBASE_APP_ID=demo-app
VITE_FIREBASE_EMULATOR=1
VITE_AUTH_PROVIDERS=google,facebook,apple
